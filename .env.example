# Copy to .env (never commit). All values are secrets except ALLOWED_USER_IDS.
TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=            # Fajrin's numeric Telegram user id, comma-separated for more
WEBHOOK_SECRET=              # random string, also passed to setWebhook secret_token
CRON_SECRET=                 # random string, also stored as GitHub Actions secret
UPSTASH_REDIS_REST_URL=      # or KV_REST_API_URL when added via Vercel Marketplace
UPSTASH_REDIS_REST_TOKEN=    # or KV_REST_API_TOKEN
GROQ_API_KEY=                # default LLM provider (Groq, OpenAI-compatible). Loaded from secrets file locally
LLM_MODEL=openai/gpt-oss-120b      # any active Groq tool-calling model, e.g. qwen/qwen3.8-27b
LLM_PROVIDER=groq            # groq (default) | openai
OPENAI_API_KEY=              # optional alternative provider
OPENAI_MODEL=               # optional, used only when provider is openai and LLM_MODEL unset
OWNER_USER_ID=               # optional; defaults to first ALLOWED_USER_IDS entry
LLM_DISABLED=                # set 1 to force rule-based only
